# Public browser configuration. Never put API keys or secrets in VITE_ variables.
# Leave blank for local review/download mode with no request or file delivery.
# Restart Vite or rebuild/redeploy after configuring an HTTPS multipart endpoint.
VITE_SERVICE_REQUEST_ENDPOINT=

# Public origin of an approved Decap-compatible GitHub OAuth service, HTTPS only.
# Example shape: https://cms-auth.yourdomain.com (not an actual service).
# No client secret, access token or query-string destination belongs here.
# Leave blank to show the HR setup screen and disable editor launch.
VITE_CAREERS_CMS_AUTH_ORIGIN=
